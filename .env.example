# ---------------------------------------------------------------------------
# OCEAN PLASTIC TRACER — Environment Variables Template
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development.
# For production deployments (Vercel, Netlify, etc.), add these as
# Environment Variables in your hosting dashboard.
#
# All variables MUST start with `VITE_` to be exposed to the browser bundle.
# ---------------------------------------------------------------------------

# ── BASEMAP TILE SOURCE ────────────────────────────────────────────────────
# Currently using the public Esri World Imagery basemap (no key required).
# To switch to MapTiler (free tier available at https://maptiler.com):
VITE_MAPTILER_KEY=YOUR_MAPTILER_KEY_HERE

# To switch to Mapbox (https://mapbox.com):
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN_HERE

# ── AI / LLM ASSISTANT (Optional) ─────────────────────────────────────────
# If you add a backend AI assistant, set your key here.
# IMPORTANT: Never expose secret keys directly — route through a backend proxy!
# VITE_AI_BACKEND_URL=https://your-api-proxy.example.com

# ── APP METADATA ──────────────────────────────────────────────────────────
VITE_APP_NAME=DRIFT-LENS
VITE_APP_VERSION=1.0.0
